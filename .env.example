# Copy to .env and fill in. Never commit .env.
# Claude API key: richer dialog texts and message checks. Without it Senim works on built-in templates and rules.
ANTHROPIC_API_KEY=
# Model for the dialog and message checks (optional)
SAFEPAUSE_LLM_MODEL=claude-opus-5-5
# "off" disables the LLM entirely (tests use this)
SAFEPAUSE_LLM=on
# Server security (Python server only; the GitHub Pages demo runs in the browser)
# off disables sessions, RBAC, CSRF and rate limits - only for local tests
SENIM_AUTH=on
# signs session cookies; set a long random value, otherwise a new one is made at every start
SENIM_SECRET=
# password for the staff, analyst and admin roles (empty: no password, demo only)
SENIM_STAFF_PASSWORD=
