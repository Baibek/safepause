# Copy to .env and fill in. Never commit .env.
# Claude API key: richer dialog texts and message checks. Without it Senim works on built-in templates and rules.
ANTHROPIC_API_KEY=
# Model for the dialog and message checks (optional)
SAFEPAUSE_LLM_MODEL=claude-opus-5-5
# "off" disables the LLM entirely (tests use this)
SAFEPAUSE_LLM=on
