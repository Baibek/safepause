{
  "_doc": "Call-scam rules. Matching runs on normalised text with ALL spaces removed (speech recognisers split and join words unpredictably), so patterns contain no spaces; use .{0,N} for gaps. A rule hits a phrase when a pattern matches and no exclude matches. Stages: AUTHORITY, THREAT, REQUEST, ISOLATION. critical=true makes the call HIGH on its own.",
  "rules": [
    {"id": "auth_bank", "stage": "AUTHORITY", "critical": false,
     "patterns": ["служб.{0,2}безопасност", "отдел.{0,2}безопасност", "қауіпсіздікқызмет", "служб.{0,2}поддержк", "кредитн.{0,3}отдел", "финансов.{0,4}мониторинг", "банк(тен|тан)хабарлас", "банкцентркредит", "центркредит", "бцк"],
     "exclude": [],
     "kk": "Банк қызметкері ретінде таныстырды", "ru": "Представился сотрудником банка"},
    {"id": "auth_police", "stage": "AUTHORITY", "critical": false,
     "patterns": ["полиц", "следовател", "прокуратур", "тергеуші", "участков", "капитан", "майор"],
     "exclude": [],
     "kk": "Полиция не тергеуші ретінде таныстырды", "ru": "Представился полицией или следователем"},
    {"id": "auth_state", "stage": "AUTHORITY", "critical": false,
     "patterns": ["национальн.{0,3}банк", "ұлттықбанк", "нацбанк", "егов", "egov", "цон", "халыққақызмет"],
     "exclude": [],
     "kk": "Мемлекеттік орган атынан сөйлеп тұр", "ru": "Говорит от имени госоргана"},
    {"id": "auth_relative", "stage": "AUTHORITY", "critical": false,
     "patterns": ["(привет|мама|мам|папа|бабушка|бабуль)этоя", "бұлменмін", "телефон(ым)?сынып", "новыйномер", "жаңанөмір"],
     "exclude": [],
     "kk": "Туысыңыз ретінде таныстырды", "ru": "Представился вашим родственником"},
    {"id": "auth_pretext", "stage": "AUTHORITY", "critical": false,
     "patterns": ["курьерск.{0,3}служб", "служб.{0,2}доставк", "пообъявлени", "олх", "olx", "крыша"],
     "exclude": [],
     "kk": "Курьер не сатып алушы деген сылтау", "ru": "Предлог: курьер или покупатель"},

    {"id": "threat_operation", "stage": "THREAT", "critical": false,
     "patterns": ["подозрительн.{0,4}(операц|перевод|активн)", "күдікті(операция|әрекет|аударым)", "мошенни", "алаяқтар", "утечк", "подугроз", "қауіптөн"],
     "exclude": [],
     "kk": "Шотыңызға қауіп төнді деп қорқытады", "ru": "Пугают угрозой вашему счёту"},
    {"id": "threat_loan", "stage": "THREAT", "critical": false,
     "patterns": ["(оформ|рәсімде).{0,25}(кредит|несие)", "(кредит|несие).{0,25}(оформ|рәсімде)", "заявк.{0,5}накредит", "атыңызға.{0,5}несие", "навашеимя.{0,15}кредит"],
     "exclude": [],
     "kk": "Атыңызға несие алынды деп айтады", "ru": "Говорят, что на вас оформили кредит"},
    {"id": "threat_blocked", "stage": "THREAT", "critical": false,
     "patterns": ["заблокир", "блокиров", "бұғатта", "блокта"],
     "exclude": [],
     "kk": "Картаңыз бұғатталды деп қорқытады", "ru": "Пугают блокировкой карты"},
    {"id": "threat_criminal", "stage": "THREAT", "critical": false,
     "patterns": ["уголовн", "қылмыстық", "возбужд.{0,5}дел", "финансировани", "соучаст"],
     "exclude": [],
     "kk": "Қылмыстық іспен қорқытады", "ru": "Пугают уголовным делом"},
    {"id": "threat_urgency", "stage": "THREAT", "critical": false,
     "patterns": ["срочно", "немедленно", "втечени.{0,15}минут", "минут(ғана|қана)", "шұғыл", "тезарада", "асығыңыз", "дереу", "поканепоздно"],
     "exclude": [],
     "kk": "Асықтырады, ойлануға уақыт бермейді", "ru": "Торопят и не дают подумать"},
    {"id": "threat_trouble", "stage": "THREAT", "critical": false,
     "patterns": ["авари", "попалв", "қиынжағдай", "чтобыне(заводили|завели)"],
     "exclude": [],
     "kk": "Туысыңыз қиын жағдайға тап болды дейді", "ru": "Говорят, что близкий попал в беду"},
    {"id": "threat_bait", "stage": "THREAT", "critical": false,
     "patterns": ["ұтыпалдыңыз", "ұтысойын", "выиграл", "компенсаци", "выплат", "гарантированн.{0,6}доход", "финансов.{0,4}аналитик", "биржи"],
     "exclude": [],
     "kk": "Ұтыс, өтемақы не оңай табыс уәде етеді", "ru": "Обещают выигрыш, компенсацию или лёгкий доход"},

    {"id": "req_safe_account", "stage": "REQUEST", "critical": true,
     "patterns": ["(безопасн|резервн|защищенн|специальн).{0,3}сч[е]т", "қауіпсіз.{0,3}шот", "сақтық.{0,3}шот", "резервтік.{0,3}шот"],
     "exclude": ["кладит.{0,3}трубк", "болмайды", "небывает", "никогданепрос", "ешқашан", "еслизвон", "еслиеам", "еслиевам", "еслиаам"],
     "kk": "Ақшаны «қауіпсіз шотқа» аударуды сұрайды — банк мұны ешқашан сұрамайды", "ru": "Просят перевести деньги на «безопасный счёт» — банк так никогда не делает"},
    {"id": "req_code", "stage": "REQUEST", "critical": true,
     "patterns": ["(смс|sms).{0,3}код", "код.{0,6}(смс|sms)", "кодты.{0,12}(айт|жібер|хабарла|аты)", "(продиктуй|назовит|назови|скажит|сообщит|айтыңыз).{0,25}код", "cvv", "cvc", "трицифр", "артындағы.{0,6}сан", "пин.?код", "пароль", "құпиясөз", "срокдействия", "(продиктуй|назовит|скажит|айт).{0,15}номер.{0,3}карт"],
     "exclude": ["никому", "ешкімге", "никогда", "ешқашан", "сұрамаймыз", "непросим", "несообщайт", "неговорит", "айтпаңыз", "айтпа"],
     "kk": "SMS-кодты, CVV-ді немесе карта деректерін сұрайды — оны ешкімге айтуға болмайды", "ru": "Просят код из SMS, CVV или данные карты — их нельзя сообщать никому"},
    {"id": "req_remote", "stage": "REQUEST", "critical": true,
     "patterns": ["anydesk", "эни.?деск", "энидеск", "rustdesk", "раст.?деск", "teamviewer", "тимвьюер", "удаленн.{0,5}доступ", "экраныңыз.{0,8}көрсет", "демонстрац.{0,5}экран", "цифры.{0,20}наэкран"],
     "exclude": [],
     "kk": "Телефоныңызды қашықтан басқаратын қолданба орнатуды сұрайды", "ru": "Просят установить программу удалённого управления телефоном"},
    {"id": "req_transfer", "stage": "REQUEST", "critical": false,
     "patterns": ["перевед", "перевест", "переведи", "переводит", "аударыңыз", "аударыпжібер", "аударукерек", "внест.{0,12}сч[е]т", "снят.{0,6}деньг", "встречн.{0,3}кредит", "оформит.{0,12}кредит", "салықтөле", "төлеукерек", "оплатит.{0,10}(пошлин|комисси|налог)"],
     "exclude": ["кладит.{0,3}трубк", "еслизвон", "еслиевам", "просятперев"],
     "kk": "Ақша аударуды, шешуді не төлеуді сұрайды", "ru": "Просят перевести, снять или заплатить деньги"},
    {"id": "req_install", "stage": "REQUEST", "critical": false,
     "patterns": ["установит.{0,12}приложени", "қолданбаныорнат", "скачайт"],
     "exclude": [],
     "kk": "Қолданба орнатуды сұрайды", "ru": "Просят установить приложение"},

    {"id": "iso_secret", "stage": "ISOLATION", "critical": false,
     "patterns": ["никомуне(говор|рассказ|сообщ)", "никомунеговори", "ешкімге(айтпа|айтпаңыз)", "туралыешкімге", "тайн.{0,3}следств", "неимеетеправа", "(папе|маме|отцу|сыну|дочери)неговори", "тайна"],
     "exclude": ["код", "карт", "пароль", "құпиясөз", "смс"],
     "kk": "Ешкімге айтпауды талап етеді", "ru": "Требуют никому не рассказывать"},
    {"id": "iso_stay", "stage": "ISOLATION", "critical": false,
     "patterns": ["некладит.{0,3}трубк", "трубкунеклад", "тұтқаныќойма", "тұтқаныкойма", "тұтқаныңызды?қойма", "ничегоненажимайт", "неходит.{0,6}отделени", "бөлімшегебарма"],
     "exclude": [],
     "kk": "Тұтқаны қоймауды не банкке бармауды сұрайды", "ru": "Просят не класть трубку и не ходить в банк"}
  ]
}
