{
 "_doc": "Call-scam rules. 'patterns' match normalised text with ALL spaces removed (speech recognisers split and join words unpredictably), so they contain no spaces; use .{0,N} for gaps. 'word' patterns match whole words in the spaced text (for short stems such as 'егов' that would otherwise match inside 'не говорите'). 'exclude' patterns mark a phrase as a safety warning: the rule does not fire on it. 'negate' patterns open a negated span (up to 45 characters, cut at the next positive imperative such as 'назовите'); a pattern match fully inside such a span does not count. The previous phrase from the same recogniser within 4 s is read together with the current one, and a negation heard by the other recogniser within 4 s cancels the hit. Stages: AUTHORITY, THREAT, REQUEST, ISOLATION. critical=true makes the call HIGH on its own.",
 "rules": [
  {
   "id": "auth_bank",
   "stage": "AUTHORITY",
   "critical": false,
   "patterns": [
    "служб.{0,2}безопасност",
    "отдел.{0,2}безопасност",
    "қауіпсіздікқызмет",
    "служб.{0,2}поддержк",
    "кредитн.{0,3}отдел",
    "финансов.{0,4}мониторинг",
    "банк(тен|тан)хабарлас",
    "банкцентркредит",
    "центркредит"
   ],
   "exclude": [],
   "kk": "Банк қызметкері ретінде таныстырды",
   "ru": "Представился сотрудником банка",
   "word": [
    "бцк"
   ]
  },
  {
   "id": "auth_police",
   "stage": "AUTHORITY",
   "critical": false,
   "patterns": [
    "полиц",
    "следовател",
    "прокуратур",
    "тергеуші",
    "участков",
    "капитан",
    "майор"
   ],
   "exclude": [],
   "kk": "Полиция не тергеуші ретінде таныстырды",
   "ru": "Представился полицией или следователем"
  },
  {
   "id": "auth_state",
   "stage": "AUTHORITY",
   "critical": false,
   "patterns": [
    "национальн.{0,3}банк",
    "ұлттықбанк",
    "нацбанк",
    "халыққақызмет"
   ],
   "exclude": [],
   "kk": "Мемлекеттік орган атынан сөйлеп тұр",
   "ru": "Говорит от имени госоргана",
   "word": [
    "егов",
    "egov",
    "цон"
   ]
  },
  {
   "id": "auth_relative",
   "stage": "AUTHORITY",
   "critical": false,
   "patterns": [
    "(привет|мама|мам|папа|бабушка|бабуль)этоя",
    "бұлменмін",
    "телефон(ым)?сынып",
    "новыйномер",
    "жаңанөмір"
   ],
   "exclude": [],
   "kk": "Туысыңыз ретінде таныстырды",
   "ru": "Представился вашим родственником"
  },
  {
   "id": "auth_pretext",
   "stage": "AUTHORITY",
   "critical": false,
   "patterns": [
    "курьерск.{0,3}служб",
    "служб.{0,2}доставк",
    "пообъявлени"
   ],
   "exclude": [],
   "kk": "Курьер не сатып алушы деген сылтау",
   "ru": "Предлог: курьер или покупатель",
   "word": [
    "олх",
    "olx"
   ]
  },
  {
   "id": "threat_operation",
   "stage": "THREAT",
   "critical": false,
   "patterns": [
    "подозрительн.{0,4}(операц|перевод|активн)",
    "күдікті(операция|әрекет|аударым)",
    "мошенни",
    "алаяқтар",
    "утечк",
    "подугроз",
    "қауіптөн"
   ],
   "exclude": [],
   "kk": "Шотыңызға қауіп төнді деп қорқытады",
   "ru": "Пугают угрозой вашему счёту"
  },
  {
   "id": "threat_loan",
   "stage": "THREAT",
   "critical": false,
   "patterns": [
    "(оформ|рәсімде).{0,25}(кредит|несие)",
    "(кредит|несие).{0,25}(оформ|рәсімде)",
    "заявк.{0,5}накредит",
    "атыңызға.{0,5}несие",
    "навашеимя.{0,15}кредит"
   ],
   "exclude": [],
   "kk": "Атыңызға несие алынды деп айтады",
   "ru": "Говорят, что на вас оформили кредит"
  },
  {
   "id": "threat_blocked",
   "stage": "THREAT",
   "critical": false,
   "patterns": [
    "заблокир",
    "блокиров",
    "бұғатта",
    "блокта"
   ],
   "exclude": [],
   "kk": "Картаңыз бұғатталды деп қорқытады",
   "ru": "Пугают блокировкой карты"
  },
  {
   "id": "threat_criminal",
   "stage": "THREAT",
   "critical": false,
   "patterns": [
    "уголовн",
    "қылмыстық",
    "возбужд.{0,5}дел",
    "финансировани",
    "соучаст"
   ],
   "exclude": [],
   "kk": "Қылмыстық іспен қорқытады",
   "ru": "Пугают уголовным делом"
  },
  {
   "id": "threat_urgency",
   "stage": "THREAT",
   "critical": false,
   "patterns": [
    "срочно",
    "немедленно",
    "втечени.{0,15}минут",
    "минут(ғана|қана)",
    "шұғыл",
    "тезарада",
    "асығыңыз",
    "дереу",
    "поканепоздно"
   ],
   "exclude": [],
   "kk": "Асықтырады, ойлануға уақыт бермейді",
   "ru": "Торопят и не дают подумать"
  },
  {
   "id": "threat_trouble",
   "stage": "THREAT",
   "critical": false,
   "patterns": [
    "авари",
    "попалв",
    "қиынжағдай",
    "чтобыне(заводили|завели)"
   ],
   "exclude": [],
   "kk": "Туысыңыз қиын жағдайға тап болды дейді",
   "ru": "Говорят, что близкий попал в беду"
  },
  {
   "id": "threat_bait",
   "stage": "THREAT",
   "critical": false,
   "patterns": [
    "ұтыпалдыңыз",
    "ұтысойын",
    "выиграл",
    "компенсаци",
    "выплат",
    "гарантированн.{0,6}доход",
    "финансов.{0,4}аналитик",
    "биржи"
   ],
   "exclude": [],
   "kk": "Ұтыс, өтемақы не оңай табыс уәде етеді",
   "ru": "Обещают выигрыш, компенсацию или лёгкий доход"
  },
  {
   "id": "req_safe_account",
   "stage": "REQUEST",
   "critical": true,
   "patterns": [
    "(безопасн|резервн|защищенн|специальн).{0,3}сч[е]т",
    "қауіпсіз.{0,3}шот",
    "сақтық.{0,3}шот",
    "резервтік.{0,3}шот"
   ],
   "exclude": [
    "кладит.{0,3}трубк",
    "болмайды",
    "небывает",
    "никогданепрос",
    "ешқашан",
    "еслизвон",
    "еслиеам",
    "еслиевам",
    "еслиаам",
    "несуществ",
    "жоқ(деп|екен)?$",
    "небывае"
   ],
   "kk": "Ақшаны «қауіпсіз шотқа» аударуды сұрайды — банк мұны ешқашан сұрамайды",
   "ru": "Просят перевести деньги на «безопасный счёт» — банк так никогда не делает"
  },
  {
   "id": "req_code",
   "stage": "REQUEST",
   "critical": true,
   "patterns": [
    "(смс|sms).{0,3}код",
    "код.{0,6}(смс|sms)",
    "кодты.{0,12}(айт|жібер|хабарла|аты)",
    "(продиктуй|назовит|назови|скажит|сообщит|айтыңыз).{0,25}код",
    "cvv",
    "cvc",
    "трицифр",
    "артындағы.{0,6}сан",
    "пин.?код",
    "срокдействия",
    "(продиктуй|назовит|скажит|айт).{0,15}номер.{0,3}карт",
    "(пароль|құпиясөз).{0,25}(банк|карт|приложен|қосымша|онлайн|кабинет|kaspi|каспи)",
    "(банк|карт|приложен|қосымша|онлайн|кабинет|kaspi|каспи).{0,25}(пароль|құпиясөз)"
   ],
   "exclude": [
    "сұрамаймыз",
    "непросим",
    "небудемпрос"
   ],
   "kk": "SMS-кодты, CVV-ді немесе карта деректерін сұрайды — оны ешкімге айтуға болмайды",
   "ru": "Просят код из SMS, CVV или данные карты — их нельзя сообщать никому",
   "negate": [
    "никому",
    "ешкімге",
    "никогда",
    "ешқашан",
    "несообщайт",
    "неговорит",
    "неназывайт",
    "недавайт",
    "айтпаңыз",
    "айтпа(?!й)",
    "(код[а-яәіңғүұқөһ]{0,3}|cvv|cvc|пароль|сан[а-яәіңғүұқөһ]{0,3}).{0,8}(никому|ешкімге)"
   ]
  },
  {
   "id": "req_remote",
   "stage": "REQUEST",
   "critical": true,
   "patterns": [
    "anydesk",
    "эни.?деск",
    "энидеск",
    "rustdesk",
    "раст.?деск",
    "teamviewer",
    "тимвьюер",
    "удаленн.{0,5}доступ",
    "экраныңыз.{0,8}көрсет",
    "демонстрац.{0,5}экран",
    "цифры.{0,20}наэкран"
   ],
   "exclude": [],
   "kk": "Телефоныңызды қашықтан басқаратын қолданба орнатуды сұрайды",
   "ru": "Просят установить программу удалённого управления телефоном"
  },
  {
   "id": "req_transfer",
   "stage": "REQUEST",
   "critical": false,
   "patterns": [
