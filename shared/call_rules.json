   "stage": "ISOLATION",
   "critical": false,
   "patterns": [
    "некладит.{0,3}трубк",
    "трубкунеклад",
    "тұтқаныќойма",
    "тұтқаныкойма",
    "тұтқаныңызды?қойма",
    "ничегоненажимайт",
